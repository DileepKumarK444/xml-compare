 "original": {
  "filename": "original.xml",
  "size": 754,
  "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Legislation xmlns=\"http://example.org/legislation\" id=\"act-2020-12\">\n  <!-- Draft of the Data Protection Act -->\n  <Title>Data Protection Act</Title>\n  <Section id=\"s1\" number=\"1\">\n    <Heading>Definitions</Heading>\n    <Text>In this Act, \"controller\" means the person who determines the purposes of processing.</Text>\n    <Reference href=\"act-2018-04\">Previous reference content</Reference>\n  </Section>\n  <Section id=\"s2\" number=\"2\" status=\"draft\">\n    <Heading>Scope</Heading>\n    <Text>This Act applies to all processing of personal data.</Text>\n  </Section>\n  <Section id=\"s3\" number=\"3\">\n    <Heading>Penalties</Heading>\n    <Text>A fine not exceeding 1000 may be imposed.</Text>\n  </Section>\n</Legislation>\n"
 },
 "modified": {
  "filename": "modified.xml",
  "size": 878,
  "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Legislation xmlns=\"http://example.org/legislation\" id=\"act-2020-12\">\n  <!-- Draft of the Data Protection Act -->\n  <Title>Data Protection Act</Title>\n  <Section id=\"s1\" number=\"1\">\n    <Heading>Interpretation</Heading>\n    <Text>In this Act, \"controller\" means the person who determines the purposes of processing.</Text>\n    <Text>New content</Text>\n  </Section>\n  <Section id=\"s2\" number=\"2\" status=\"final\" effective=\"2021-01-01\">\n    <Heading>Scope</Heading>\n    <Text>This Act applies to all processing of personal data.</Text>\n  </Section>\n  <Section id=\"s3\" number=\"3\">\n    <Heading>Penalties</Heading>\n    <Text>A fine not exceeding 5000 may be imposed.</Text>\n  </Section>\n  <Section id=\"s4\" number=\"4\">\n    <Heading>Commencement</Heading>\n    <Text>This Act comes into force on 1 January 2021.</Text>\n  </Section>\n</Legislation>\n"
 },
